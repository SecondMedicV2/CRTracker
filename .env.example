# Copy to backend/.env and fill in. Never commit the real file.

# --- Required ---------------------------------------------------------------
# Long random string (32+ characters). Signs login sessions and keys the mobile-number lookup hash.
# Changing it later logs everybody out AND breaks mobile-number matching until patients.mobile_hash is rebuilt.
SECRET_KEY=change-me-to-a-long-random-string
# Encrypts stored lab reports and mobile numbers. Make one with:  python -m app.storage
# LOSING THIS KEY MEANS LOSING ACCESS TO THE STORED REPORTS. Back it up separately from the database.
FILE_ENCRYPTION_KEY=

# --- Database and files -----------------------------------------------------
DATABASE_URL=sqlite:///./crtracker.db
# Production: postgresql+psycopg://user:password@host/crtracker
STORAGE_DIR=./storage

# --- Web ---------------------------------------------------------------------
# true when served over HTTPS (also enforces a 32+ character SECRET_KEY)
COOKIE_SECURE=false
# Sites allowed to make changes from a browser. Put the real site address here when hosting.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- First admin, used only by `python -m app.seed` ---------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-10-chars

# --- Lab and AI --------------------------------------------------------------
# mock = made-up reports for testing. thyrocare is NOT finished (waiting for their API documents).
LAB_PROVIDER=mock
# template = built-in, needs no key. anthropic = optional. gemini = Google Gemini.
LLM_PROVIDER=template
LLM_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AI_PATIENT_DATA=deidentified
